{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@core": ["./backend/src/core/index.ts"],
      "@core/*": ["./backend/src/core/*"],
      "@features": ["./backend/src/features/index.ts"],
      "@features/*": ["./backend/src/features/*"],
      "@services": ["./backend/src/services/index.ts"],
      "@services/*": ["./backend/src/services/*"],
      "@controllers": ["./backend/src/controllers/index.ts"],
      "@controllers/*": ["./backend/src/controllers/*"],
      "@routes": ["./backend/src/routes/index.ts"],
      "@routes/*": ["./backend/src/routes/*"],
      "@middleware": ["./backend/src/middleware/index.ts"],
      "@middleware/*": ["./backend/src/middleware/*"],
      "@integrations": ["./backend/src/integrations/index.ts"],
      "@integrations/*": ["./backend/src/integrations/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
